# Copy to .env on the server. Never commit the populated file.
IMAGE_TAG=staging
API_DOMAIN=api.example.com
API_CORS_ORIGIN=https://app.example.com
COOKIE_DOMAIN=.example.com

POSTGRES_DB=rms
POSTGRES_USER=rms_app
POSTGRES_PASSWORD=generate-a-long-random-value
REDIS_PASSWORD=generate-a-long-random-value
JWT_ACCESS_SECRET=generate-at-least-32-random-bytes
JWT_REFRESH_SECRET=generate-at-least-32-random-bytes

S3_REGION=us-east-1
S3_PROOF_BUCKET=replace-with-private-bucket-name
S3_BACKUP_BUCKET=replace-with-private-backup-bucket-name
S3_MEDIA_BUCKET=replace-with-media-bucket-name
MEDIA_CDN_URL=https://replace-with-cloudfront-domain
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/rms-staging
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-restricted-deployment-key
AWS_SECRET_ACCESS_KEY=replace-with-restricted-deployment-secret
